#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2022b/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2022b/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "../protos/OmniWheel.proto"

WorldInfo {
  # Small timestep keeps the light passive omni-wheel rollers stable.
  basicTimeStep 8
  contactProperties [
    ContactProperties {
      material1 "omni_wheel"
      material2 "field"
      # Plain symmetric friction: the passive rollers provide the free direction.
      # (Asymmetric friction can't be used here: the field is a Mesh.)
      coulombFriction [ 1 ]
      bounce 0
    }
  ]
}
Viewpoint {
  orientation -0.33185733874619844 -0.09874274160469809 0.9381474178937331 3.686018050088086
  position 1.700313773507203 1.0549607538959629 1.4846240848267684
  follow "sentry"
}
TexturedBackground {
}
TexturedBackgroundLight {
}
Solid {
  translation 0 0 0
  rotation 1 0 0 0
  children [
    Transform {
      scale 1 1 1   # Use 1 1 1 if exported in meters instead of mm
      children [
        CadShape {
          url [ "2026_ARC_3v3.obj" ]
        }
      ]
    }
  ]
  name "competition_field"
  contactMaterial "field"
  boundingObject Transform {
    scale 1 1 1     # Must match visual scale
    children [
      Mesh {
        url [ "2026_ARC_3v3.obj" ]
      }
    ]
  }
}
Robot {
  # Spawn in open floor; the origin is inside the 1.4 m centre wall (x = 0).
  translation 2.0 0.33 0.175
  children [
    # X-drive: wheels at 45 deg on a 0.315 m radius, axles pointing radially outward.
    # Values must match sentry_description/urdf/sentry.urdf.xacro and SentryDriver.cpp.
    OmniWheel {
      axis 0.7071068 0.7071068 0
      anchor 0.22273864 0.22273864 -0.10
      endTranslation 0.22273864 0.22273864 -0.10
      endRotation 0 0 1 -0.7853982
      motorName "front_left_wheel_joint"
      sensorName "front_left_wheel_joint_sensor"
      name "front_left_wheel_link"
    }
    OmniWheel {
      axis 0.7071068 -0.7071068 0
      anchor 0.22273864 -0.22273864 -0.10
      endTranslation 0.22273864 -0.22273864 -0.10
      endRotation 0 0 1 -2.3561945
      motorName "front_right_wheel_joint"
      sensorName "front_right_wheel_joint_sensor"
      name "front_right_wheel_link"
    }
    OmniWheel {
      axis -0.7071068 0.7071068 0
      anchor -0.22273864 0.22273864 -0.10
      endTranslation -0.22273864 0.22273864 -0.10
      endRotation 0 0 1 0.7853982
      motorName "rear_left_wheel_joint"
      sensorName "rear_left_wheel_joint_sensor"
      name "rear_left_wheel_link"
    }
    OmniWheel {
      axis -0.7071068 -0.7071068 0
      anchor -0.22273864 -0.22273864 -0.10
      endTranslation -0.22273864 -0.22273864 -0.10
      endRotation 0 0 1 2.3561945
      motorName "rear_right_wheel_joint"
      sensorName "rear_right_wheel_joint_sensor"
      name "rear_right_wheel_link"
    }
    # Chassis (base_link)
    Shape {
      appearance PBRAppearance {
        baseColor 0.25 0.25 0.28
        roughness 0.5
        metalness 0.4
      }
      geometry DEF BODY Cylinder {
        height 0.30
        radius 0.2897
      }
    }
  ]
  boundingObject USE BODY
  physics Physics {
    density -1
    mass 10.0
  }
  controller "<extern>"
  name "sentry"
}
