                  roughness 0.8
                  metalness 0.1
                }
                geometry Cylinder {
                  height 0.04
                  radius 0.075
                }
              }
            ]
          }
        ]
        name "front_left_wheel_link"
        boundingObject USE OMNI_WHEEL
        physics Physics {
          density -1
          mass 0.5
        }
      }
    }
    # Front-Right Wheel (-45 deg)
    HingeJoint {
      jointParameters HingeJointParameters {
