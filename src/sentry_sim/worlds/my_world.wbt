#VRML_SIM R2022b utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2022b/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2022b/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"

WorldInfo {
  contactProperties [
    ContactProperties {
      material1 "omni_wheel"
      coulombFriction [ 2, 0 ]
      bounce 0
    }
  ]
}
Viewpoint {
  orientation -0.33185733874619844 -0.09874274160469809 0.9381474178937331 3.686018050088086
  position 1.700313773507203 1.0549607538959629 1.4846240848267684
  follow "my_robot"
}
TexturedBackground {
}
TexturedBackgroundLight {
}
Solid {
  translation 0 0 0
  rotation 1 0 0 0
  children [
    Transform {
      scale 1 1 1   # Use 1 1 1 if exported in meters instead of mm
      children [
        CadShape {
          url [ "2026_ARC_3v3.obj" ]
        }
      ]
    }
  ]
  name "competition_field"
  boundingObject Transform {
    scale 1 1 1     # Must match visual scale
    children [
      Mesh {
        url [ "2026_ARC_3v3.obj" ]
      }
    ]
  }
}
Robot {
  children [
    # Wheel 0: Front-Left (+45 deg)
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0.7071068 0.7071068 0
        anchor 0.0318198 0.0318198 0.025
      }
      device [
        RotationalMotor {
          name "wheel0_motor"
        }
      ]
      endPoint Solid {
        translation 0.0318198 0.0318198 0.025
        rotation 0 0 1 -0.7853982
        contactMaterial "omni_wheel"
        children [
          DEF OMNI_WHEEL Transform {
            rotation 1 0 0 1.5707963
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 1 0 0
                  roughness 1
                  metalness 0
                }
                geometry Cylinder {
                  height 0.01
                  radius 0.025
                }
              }
            ]
          }
        ]
        name "wheel0"
        boundingObject USE OMNI_WHEEL
        physics Physics {
        }
      }
    }
    # Wheel 1: Back-Left (+135 deg)
    HingeJoint {
      jointParameters HingeJointParameters {
        axis -0.7071068 0.7071068 0
        anchor -0.0318198 0.0318198 0.025
      }
      device [
        RotationalMotor {
          name "wheel1_motor"
        }
      ]
      endPoint Solid {
        translation -0.0318198 0.0318198 0.025
        rotation 0 0 1 0.7853982
        contactMaterial "omni_wheel"
        children [
          USE OMNI_WHEEL
        ]
        name "wheel1"
        boundingObject USE OMNI_WHEEL
        physics Physics {
        }
      }
    }
    # Wheel 2: Back-Right (-135 deg)
    HingeJoint {
      jointParameters HingeJointParameters {
        axis -0.7071068 -0.7071068 0
        anchor -0.0318198 -0.0318198 0.025
      }
      device [
        RotationalMotor {
          name "wheel2_motor"
        }
      ]
      endPoint Solid {
        translation -0.0318198 -0.0318198 0.025
        rotation 0 0 1 2.3561945
        contactMaterial "omni_wheel"
        children [
          USE OMNI_WHEEL
        ]
        name "wheel2"
        boundingObject USE OMNI_WHEEL
        physics Physics {
        }
      }
    }
    # Wheel 3: Front-Right (-45 deg)
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0.7071068 -0.7071068 0
        anchor 0.0318198 -0.0318198 0.025
      }
      device [
        RotationalMotor {
          name "wheel3_motor"
        }
      ]
      endPoint Solid {
        translation 0.0318198 -0.0318198 0.025
        rotation 0 0 1 -2.3561945
        contactMaterial "omni_wheel"
        children [
          USE OMNI_WHEEL
        ]
        name "wheel3"
        boundingObject USE OMNI_WHEEL
        physics Physics {
        }
      }
    }
    Transform {
      translation 0 0 0.0415
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0 0 1
            roughness 0
            metalness 1
          }
          geometry DEF BODY Cylinder {
            height 0.08
            radius 0.045
          }
        }
      ]
    }
    Lidar {
      translation 0 0 0.095          # Centered on top deck (body top is at z = 0.0815)
      rotation 0 0 1 0               # Aligned straight forward (+X)
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.15 0.15 0.15
            roughness 0.4
            metalness 0.6
          }
          geometry Cylinder {
            height 0.027             # Sits flush on z = 0.0815 (0.095 - 0.027/2)
            radius 0.03              # Scaled to fit the 0.045 m robot body; cleared by near 0.05
          }
        }
      ]
      name "lidar"
      tiltAngle 0.0                  # ~22.5 deg upward pitch (centers -7° to +52° VFOV)
      horizontalResolution 500       # 500 pts/layer * 40 layers = 20,000 pts/scan
      fieldOfView 6.283185           # 360 deg horizontal FOV (2*pi)
      verticalFieldOfView 1.815142   # 59 deg vertical FOV (-7° to +52°)
      numberOfLayers 70              # Matches Mid-360's 40-line equivalent density
      near 0.05                      # Clears the 0.03 m sensor housing without hurting depth precision
      minRange 0.1                   # 10 cm close-proximity blind zone
      maxRange 70.0                  # 70 m (@ 80% reflectivity); use 40.0 for 10% reflectivity
      type "fixed"                   # Single-step 360° capture (avoids distortion)
      projection "cylindrical"       # Required for FOV > pi
      noise 0.000286                 # 0.02 m / 70.0 m -> 2 cm (1σ) Gaussian range noise
      resolution -1.0                # Continuous depth resolution
      defaultFrequency 10            # 10 Hz typical frame rate (200,000 pts/s total)
      minFrequency 10
      maxFrequency 10
    }
    DistanceSensor {
      translation 0.042 0.02 0.063
      rotation 0 0 1 0.5236003061004253
      children [
        DEF SENSOR Transform {
          rotation 0 1 0 1.5708
          children [
            Shape {
              appearance PBRAppearance {
                baseColor 1 1 0
                roughness 0
                metalness 1
              }
              geometry Cylinder {
                height 0.004
                radius 0.008
              }
            }
          ]
        }
      ]
      name "ds0"
      lookupTable [
        0 1020 0
        0.05 1020 0
        0.15 0 0
      ]
      numberOfRays 2
      aperture 1
    }
    DistanceSensor {
      translation 0.042 -0.02 0.063
      rotation 0 0 1 -0.5235996938995747
      children [
        USE SENSOR
      ]
      name "ds1"
      lookupTable [
        0 1020 0
        0.05 1020 0
        0.15 0 0
      ]
      numberOfRays 2
      aperture 1
    }
  ]
  boundingObject Transform {
    translation 0 0 0.0415
    children [
      USE BODY
    ]
  }
  physics Physics {
  }
  controller "<extern>"
  name "my_robot"
}
