<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="sentry">

  <!-- Chassis Properties -->
  <xacro:property name="base_radius" value="0.2897"/>
  <xacro:property name="base_length" value="0.30"/>
  <xacro:property name="base_mass"   value="10.0"/>

  <!-- Omniwheel Properties -->
  <xacro:property name="wheel_radius" value="0.075"/>
  <xacro:property name="wheel_width"  value="0.04"/>
  <xacro:property name="wheel_mass"   value="0.5"/>
  <!-- Placed slightly outside base_radius (0.2897) to avoid self-collision -->
  <xacro:property name="mount_radius" value="0.315"/>
  <!-- Places bottom of wheels 2.5 cm below the bottom of base_link -->
  <xacro:property name="wheel_z"      value="-0.10"/>

  <!-- Materials -->
  <material name="chassis_gray">
    <color rgba="0.25 0.25 0.28 1.0"/>
  </material>
  <material name="wheel_dark">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="${base_length}" radius="${base_radius}"/>
      </geometry>
      <material name="chassis_gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="${base_length}" radius="${base_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${base_mass}"/>
      <inertia
        ixx="${(1.0/12.0) * base_mass * (3*base_radius*base_radius + base_length*base_length)}"
        ixy="0.0" ixz="0.0"
        iyy="${(1.0/12.0) * base_mass * (3*base_radius*base_radius + base_length*base_length)}"
        iyz="0.0"
        izz="${0.5 * base_mass * base_radius * base_radius}"/>
    </inertial>
  </link>

  <!-- 4-Wheel Omniwheel Macro -->
  <xacro:macro name="omni_wheel" params="prefix angle">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <!-- Local +X points radially outward; +Y points tangentially -->
      <origin
        xyz="${mount_radius * cos(angle)} ${mount_radius * sin(angle)} ${wheel_z}"
        rpy="0 0 ${angle}"/>
      <!-- Spin around the radial axle -->
      <axis xyz="1 0 0"/>
    </joint>

    <link name="${prefix}_wheel_link">
      <visual>
        <!-- Rotate cylinder Z-axis to align with the X-axis wheel axle -->
        <origin xyz="0 0 0" rpy="0 ${pi/2} 0"/>
        <geometry>
          <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
        </geometry>
        <material name="wheel_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 ${pi/2} 0"/>
        <geometry>
          <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 ${pi/2} 0"/>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${(1.0/12.0) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          ixy="0.0" ixz="0.0"
          iyy="${(1.0/12.0) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          iyz="0.0"
          izz="${0.5 * wheel_mass * wheel_radius * wheel_radius}"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- Instantiate the 4 Omniwheels in an X-Configuration -->
  <xacro:omni_wheel prefix="front_left"  angle="${pi/4}"/>
  <xacro:omni_wheel prefix="front_right" angle="${-pi/4}"/>
  <xacro:omni_wheel prefix="rear_left"   angle="${3*pi/4}"/>
  <xacro:omni_wheel prefix="rear_right"  angle="${-3*pi/4}"/>

  <!-- Webots Driver Plugin -->
  <webots>
    <plugin type="SentryDriver" />
  </webots>

</robot>
